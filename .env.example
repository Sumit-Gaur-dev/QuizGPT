# # =====================================================================
# # Quiz RAG - Environment Configuration
# # =====================================================================

# # 1. Gemini API Key for Quiz Generation & Evaluation (Phase 6)
# # Paste your API key below when ready to run live Gemini requests.
# GOOGLE_API_KEY=

# # 2. Gemini Generation Model
# GEMINI_MODEL=gemini-2.5-flash

# # 3. Embedding Provider Configuration (V1 default: huggingface 100% local)
# EMBEDDING_PROVIDER=huggingface
# HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# # Optional Embedding Providers (only needed if EMBEDDING_PROVIDER changed)
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# # 4. Local ChromaDB Storage Directory
# CHROMA_PERSIST_DIR=storage/chroma_db
